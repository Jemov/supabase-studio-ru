+  ["postgis_raster", { original: "PostGIS raster types and functions", russian: "Растровые типы и функции PostGIS" }],
+  ["postgis_sfcgal", { original: "PostGIS SFCGAL functions", russian: "Функции SFCGAL в PostGIS" }],
+  ["postgis_tiger_geocoder", { original: "PostGIS tiger geocoder and reverse geocoder", russian: "Прямое и обратное геокодирование TIGER в PostGIS" }],
+  ["postgis_topology", { original: "PostGIS topology spatial types and functions", russian: "Пространственные типы и функции топологии PostGIS" }],
+  ["postgres_fdw", { original: "foreign-data wrapper for remote PostgreSQL servers", russian: "Обёртка внешних данных для удалённых серверов PostgreSQL" }],
+  ["refint", { original: "functions for implementing referential integrity (obsolete)", russian: "Функции обеспечения ссылочной целостности (устарело)" }],
+  ["rum", { original: "RUM index access method", russian: "Метод доступа к индексу RUM" }],
+  ["seg", { original: "data type for representing line segments or floating-point intervals", russian: "Тип данных для отрезков и интервалов с плавающей точкой" }],
+  ["sslinfo", { original: "information about SSL certificates", russian: "Сведения о сертификатах SSL" }],
+  ["supabase_vault", { original: "Supabase Vault Extension", russian: "Расширение Supabase Vault" }],
+  ["tablefunc", { original: "functions that manipulate whole tables, including crosstab", russian: "Функции обработки целых таблиц, включая сводные таблицы crosstab" }],
+  ["tcn", { original: "Triggered change notifications", russian: "Уведомления об изменениях через триггеры" }],
+  ["tsm_system_rows", { original: "TABLESAMPLE method which accepts number of rows as a limit", russian: "Метод TABLESAMPLE с ограничением по числу строк" }],
+  ["tsm_system_time", { original: "TABLESAMPLE method which accepts time in milliseconds as a limit", russian: "Метод TABLESAMPLE с ограничением по времени в миллисекундах" }],
+  ["unaccent", { original: "text search dictionary that removes accents", russian: "Словарь текстового поиска, удаляющий диакритические знаки" }],
+  ["uuid-ossp", { original: "generate universally unique identifiers (UUIDs)", russian: "Создание универсальных уникальных идентификаторов (UUID)" }],
+  ["vector", { original: "vector data type and ivfflat and hnsw access methods", russian: "Векторный тип данных и методы доступа ivfflat и hnsw" }],
+  ["wrappers", { original: "Foreign data wrappers developed by Supabase", russian: "Обёртки внешних данных, разработанные Supabase" }],
+  ["xml2", { original: "XPath querying and XSLT", russian: "Запросы XPath и преобразования XSLT" }],
+])
+
+export function getExtensionCommentDisplay(
+  name: string,
+  comment: string | null | undefined
+): string | null | undefined {
+  const entry = STOCK_EXTENSION_COMMENTS.get(name)
+  return entry !== undefined && entry.original === comment ? entry.russian : comment
+}
