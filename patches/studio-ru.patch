+  ["pg_jsonschema", { original: "pg_jsonschema", russian: "Расширение pg_jsonschema" }],
+  ["pg_net", { original: "Async HTTP", russian: "Асинхронные HTTP-запросы" }],
+  ["pg_partman", { original: "Extension to manage partitioned tables by time or ID", russian: "Управление таблицами, секционированными по времени или ID" }],
