diff --git a/apps/studio/data/content/content-error-display.ts b/apps/studio/data/content/content-error-display.ts
new file mode 100644
index 0000000..3ec7728
--- /dev/null
+++ b/apps/studio/data/content/content-error-display.ts
@@ -0,0 +1,26 @@
+const CONTENT_ERROR_LABELS: Record<string, string> = {
+  'Content not found.': 'Содержимое не найдено.',
+  'Content not found': 'Содержимое не найдено',
+  'Failed to create snippet': 'Не удалось создать фрагмент',
+  'Failed to update snippet': 'Не удалось обновить фрагмент',
+  'Failed to delete snippets': 'Не удалось удалить фрагменты',
+  'Snippet IDs are required': 'Укажите ID фрагментов',
+  'Folder IDs are required': 'Укажите ID папок',
+}
+
+/** Localizes content error display without changing the raw Error used by API/status matchers. */
+export const getContentErrorDisplayMessage = (message: string | undefined) => {
+  if (message === undefined) return undefined
+  if (Object.hasOwn(CONTENT_ERROR_LABELS, message)) return CONTENT_ERROR_LABELS[message]
+
+  const snippetNotFound = message.match(/^Snippet with id (.+) not found$/s)
+  if (snippetNotFound) return `Фрагмент с ID ${snippetNotFound[1]} не найден`
+
+  const folderNotFound = message.match(/^Folder with id (.+) not found$/s)
+  if (folderNotFound) return `Папка с ID ${folderNotFound[1]} не найдена`
+
+  const schemaNotFound = message.match(/^schema ("(?:[^"]|"")+") does not exist$/)
+  if (schemaNotFound) return `Схема ${schemaNotFound[1]} не существует`
+
+  return message
+}
