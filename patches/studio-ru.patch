+export function getOperationLabel(operation: string): string {
+  const parallel = operation.startsWith('Parallel ')
+  const partial = operation.startsWith('Partial ')
+  const finalize = operation.startsWith('Finalize ')
+  const prefix = parallel ? 'Параллельное: ' : partial ? 'Частичная: ' : finalize ? 'Завершение: ' : ''
+  const name = parallel || partial || finalize ? operation.slice(operation.indexOf(' ') + 1) : operation
+  // The text-plan parser retains the raw index/provider identifier in this caption.
+  const scanUsing = name.match(/^(Index(?: Only)? Scan(?: Backward)?) using (.+)$/)
+  if (scanUsing && Object.hasOwn(OPERATION_LABELS, scanUsing[1])) {
+    return prefix + OPERATION_LABELS[scanUsing[1]] + ' · ' + scanUsing[2]
+  }
+  const customScan = name.match(/^Custom Scan [(](.*)[)]$/)
+  if (customScan) return prefix + OPERATION_LABELS['Custom Scan'] + ' (' + customScan[1] + ')'
+  return prefix + (Object.hasOwn(OPERATION_LABELS, name) ? OPERATION_LABELS[name] : name)
+}
+
+export function getDetailLabel(label: string): string {
+  const key = label.replace(/:$/, '').trim()
+  const worker = key.match(/^Worker ([0-9]+)$/)
+  if (worker) return 'Воркер ' + worker[1] + ':'
+  return Object.hasOwn(DETAIL_LABELS, key) ? DETAIL_LABELS[key] + ':' : label
+}
