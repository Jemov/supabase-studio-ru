+export const getErrorCodeHelpMessage = (service: string, code: string, message?: string | null) => {
+  if (message === null || message === undefined) return message
+  if (!Object.prototype.hasOwnProperty.call(ERROR_HELP_MESSAGES, service)) return message
+  const serviceMessages = ERROR_HELP_MESSAGES[service]
+  if (!Object.prototype.hasOwnProperty.call(serviceMessages, code)) return message
+  const entry = serviceMessages[code]
+  return message === entry.original ? entry.translated : message
+}
