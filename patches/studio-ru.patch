+  ["isn", { original: "data types for international product numbering standards", russian: "Типы данных для международных стандартов нумерации товаров" }],
+  ["lo", { original: "Large Object maintenance", russian: "Обслуживание больших объектов" }],
+  ["ltree", { original: "data type for hierarchical tree-like structures", russian: "Тип данных для иерархических древовидных структур" }],
