+  ["pg_visibility", { original: "examine the visibility map (VM) and page-level visibility info", russian: "Просмотр карты видимости (VM) и сведений о видимости на уровне страниц" }],
+  ["pg_walinspect", { original: "functions to inspect contents of PostgreSQL Write-Ahead Log", russian: "Функции просмотра содержимого журнала упреждающей записи PostgreSQL" }],
+  ["pgaudit", { original: "provides auditing functionality", russian: "Аудит операций в базе данных" }],
+  ["pgcrypto", { original: "cryptographic functions", russian: "Криптографические функции" }],
+  ["pgjwt", { original: "JSON Web Token API for Postgresql", russian: "API токенов JSON Web Token для PostgreSQL" }],
+  ["pgmq", { original: "A lightweight message queue. Like AWS SQS and RSMQ but on Postgres.", russian: "Лёгкая очередь сообщений в PostgreSQL, подобная AWS SQS и RSMQ." }],
+  ["pgroonga", { original: "Super fast and all languages supported full text search index based on Groonga", russian: "Быстрый индекс полнотекстового поиска на основе Groonga с поддержкой всех языков" }],
+  ["pgroonga_database", { original: "PGroonga database management module", russian: "Модуль управления базами данных PGroonga" }],
+  ["pgrouting", { original: "pgRouting Extension", russian: "Расширение pgRouting" }],
+  ["pgrowlocks", { original: "show row-level locking information", russian: "Просмотр сведений о блокировках строк" }],
+  ["pgsodium", { original: "Postgres extension for libsodium functions", russian: "Расширение PostgreSQL для функций libsodium" }],
+  ["pgstattuple", { original: "show tuple-level statistics", russian: "Просмотр статистики на уровне строк" }],
+  ["pgtap", { original: "Unit testing for PostgreSQL", russian: "Модульное тестирование PostgreSQL" }],
+  ["plpgsql", { original: "PL/pgSQL procedural language", russian: "Процедурный язык PL/pgSQL" }],
+  ["plpgsql_check", { original: "extended check for plpgsql functions", russian: "Расширенная проверка функций PL/pgSQL" }],
