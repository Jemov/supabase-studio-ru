diff --git a/packages/ui-patterns/src/SqlToRest/error-hint-display.ts b/packages/ui-patterns/src/SqlToRest/error-hint-display.ts
new file mode 100644
index 0000000..1501dd1
--- /dev/null
+++ b/packages/ui-patterns/src/SqlToRest/error-hint-display.ts
@@ -0,0 +1,16 @@
+// Exact fixed explanatory hints from @supabase/sql-to-rest 0.1.6.
+// Raw parser errors, SQL and unknown/custom hints are never modified.
+const SQL_TO_REST_HINT_DISPLAY: Readonly<Record<string, string>> = Object.freeze({
+  "Did you leave a trailing comma in the select target list?": "Проверьте, нет ли лишней запятой в конце списка столбцов SELECT.",
+  "Do you have an incomplete join in the FROM clause?": "Проверьте, завершено ли соединение JOIN в предложении FROM.",
+  "Did you forget to join that relation or alias it to something else?": "Возможно, вы забыли соединить эту таблицу или задать ей другой псевдоним.",
+  "Did you forget to wrap your value in single quotes?": "Возможно, вы забыли заключить значение в одинарные кавычки.",
+  "Did you forget to quote a JSON path?": "Возможно, вы забыли заключить путь JSON в кавычки.",
+})
+
+export function getSqlToRestHintDisplay(hint: string | undefined): string | undefined {
+  if (hint === undefined) return hint
+  return Object.prototype.hasOwnProperty.call(SQL_TO_REST_HINT_DISPLAY, hint)
+    ? SQL_TO_REST_HINT_DISPLAY[hint]
+    : hint
+}
