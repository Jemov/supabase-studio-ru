 ])
+
+// Keep canonical API region names intact; translate only their presentation.
+const REGION_DISPLAY_NAMES_RU: Record<string, string> = {
+  "us-west-1": "Запад США (Северная Калифорния)",
+  "us-west-2": "Запад США (Орегон)",
+  "us-east-1": "Восток США (Северная Вирджиния)",
+  "us-east-2": "Восток США (Огайо)",
+  "ca-central-1": "Канада (Центральный регион)",
+  "eu-west-1": "Запад Европы (Ирландия)",
+  "eu-west-2": "Запад Европы (Лондон)",
+  "eu-west-3": "Запад Европы (Париж)",
+  "eu-central-1": "Центральная Европа (Франкфурт)",
+  "eu-central-2": "Центральная Европа (Цюрих)",
+  "eu-north-1": "Северная Европа (Стокгольм)",
+  "ap-south-1": "Южная Азия (Мумбаи)",
+  "ap-southeast-1": "Юго-Восточная Азия (Сингапур)",
+  "ap-northeast-1": "Северо-Восточная Азия (Токио)",
+  "ap-northeast-2": "Северо-Восточная Азия (Сеул)",
+  "ap-southeast-2": "Океания (Сидней)",
+  "sa-east-1": "Южная Америка (Сан-Паулу)"
+}
+
+export const getRegionDisplayName = (canonicalNameOrCode: string | undefined): string | undefined => {
+  if (canonicalNameOrCode === undefined) return undefined
+  const smartRegionNames: Record<string, string> = {
+    Americas: 'Америка',
+    Europe: 'Европа',
+    APAC: 'Азиатско-Тихоокеанский регион',
+    'Asia-Pacific': 'Азиатско-Тихоокеанский регион',
+  }
+  if (Object.hasOwn(smartRegionNames, canonicalNameOrCode)) return smartRegionNames[canonicalNameOrCode]
+  const region = Object.values(AWS_REGIONS).find(
+    (region) => region.code === canonicalNameOrCode || region.displayName === canonicalNameOrCode
+  )
+  return region ? REGION_DISPLAY_NAMES_RU[region.code] : canonicalNameOrCode
+}
