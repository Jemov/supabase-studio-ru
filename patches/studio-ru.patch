+  ["btree_gist", { original: "support for indexing common datatypes in GiST", russian: "Поддержка индексации распространённых типов данных в GiST" }],
+  ["citext", { original: "data type for case-insensitive character strings", russian: "Тип данных для строк без учёта регистра" }],
+  ["cube", { original: "data type for multidimensional cubes", russian: "Тип данных для многомерных кубов" }],
