+++ b/packages/ui/src/lib/api-error-display.ts
@@ -0,0 +1,34 @@
+const API_ERROR_DISPLAY_LABELS: Record<string, string> = {
+  'API error happened while trying to communicate with the server.':
+    'Ошибка API при обращении к серверу.',
+}
+
+/** Formats only known built-in UI captions; raw errors and custom messages stay unchanged. */
+export function getApiErrorDisplayMessage<T>(message: T): T extends string ? string : T
+export function getApiErrorDisplayMessage(message: unknown): unknown {
+  if (typeof message === 'string' && Object.hasOwn(API_ERROR_DISPLAY_LABELS, message)) {
+    return API_ERROR_DISPLAY_LABELS[message]
+  }
+  return message
+}
+
+/** A caption that implicitly interpolates an Error may format only its canonical built-in value. */
+export function getApiErrorDisplayValue<T>(value: T): T | string {
+  if (!(value instanceof Error)) return getApiErrorDisplayMessage(value) as T | string
+
+  const message = Object.getOwnPropertyDescriptor(value, 'message')
+  if (!message || !('value' in message) || typeof message.value !== 'string') return value
+  if (!Object.hasOwn(API_ERROR_DISPLAY_LABELS, message.value)) return value
+
+  // Read descriptors, never an accessor or a custom toString implementation.
+  let prototype: object | null = value
+  while (prototype) {
+    const toString = Object.getOwnPropertyDescriptor(prototype, 'toString')
+    if (toString) {
+      if (!('value' in toString) || toString.value !== Error.prototype.toString) return value
+      return API_ERROR_DISPLAY_LABELS[message.value]
+    }
+    prototype = Object.getPrototypeOf(prototype)
+  }
+  return value
+}
