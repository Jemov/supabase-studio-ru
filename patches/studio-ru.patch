diff --git a/apps/studio/lib/drag-accessibility.ts b/apps/studio/lib/drag-accessibility.ts
new file mode 100644
index 0000000..378a46e
--- /dev/null
+++ b/apps/studio/lib/drag-accessibility.ts
@@ -0,0 +1,39 @@
+import type { DndContextProps } from '@dnd-kit/core'
+
+type DragAccessibility = NonNullable<DndContextProps['accessibility']>
+
+/** Display-only defaults; event IDs, sensors, ordering and focus behavior stay unchanged. */
+const RUSSIAN_DRAG_ACCESSIBILITY: DragAccessibility = {
+  screenReaderInstructions: {
+    draggable:
+      'Чтобы поднять перемещаемый элемент, нажмите пробел. Используйте клавиши со стрелками, чтобы переместить элемент. Нажмите пробел ещё раз, чтобы опустить его на новом месте, или Escape, чтобы отменить перемещение.',
+  },
+  announcements: {
+    onDragStart: ({ active }) => `Поднят перемещаемый элемент ${active.id}.`,
+    onDragOver: ({ active, over }) =>
+      over
+        ? `Перемещаемый элемент ${active.id} находится над областью ${over.id}.`
+        : `Перемещаемый элемент ${active.id} больше не находится над областью размещения.`,
+    onDragEnd: ({ active, over }) =>
+      over
+        ? `Перемещаемый элемент ${active.id} опущен в область ${over.id}`
+        : `Перемещаемый элемент ${active.id} опущен.`,
+    onDragCancel: ({ active }) =>
+      `Перемещение отменено. Перемещаемый элемент ${active.id} опущен.`,
+  },
+}
+
+/** Explicit caller customization keeps priority over the Russian defaults. */
+export function getRussianDragAccessibility(custom?: DragAccessibility): DragAccessibility {
+  return {
+    ...custom,
+    screenReaderInstructions: {
+      ...RUSSIAN_DRAG_ACCESSIBILITY.screenReaderInstructions!,
+      ...custom?.screenReaderInstructions,
+    },
+    announcements: {
+      ...RUSSIAN_DRAG_ACCESSIBILITY.announcements!,
+      ...custom?.announcements,
+    },
+  }
+}
