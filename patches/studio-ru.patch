diff --git a/apps/studio/lib/api-error-display.test.ts b/apps/studio/lib/api-error-display.test.ts
new file mode 100644
index 0000000..f801754
--- /dev/null
+++ b/apps/studio/lib/api-error-display.test.ts
@@ -0,0 +1,106 @@
+import { describe, expect, it } from 'vitest'
+
+import { getApiErrorDisplayMessage, getApiErrorDisplayValue } from 'ui/src/lib/api-error-display'
+import { ResponseError } from '@/types/base'
+
+const builtInMessage = 'API error happened while trying to communicate with the server.'
+
+describe('getApiErrorDisplayMessage', () => {
+  it('localizes the exact built-in default without mutating the raw ResponseError', () => {
+    const error = new ResponseError(undefined, 500, 'test-request', 10, '/api/test')
+    const rawProperties = Object.getOwnPropertyDescriptors(error)
+    expect(getApiErrorDisplayMessage(error.message)).toBe('Ошибка API при обращении к серверу.')
+    expect(Object.getOwnPropertyDescriptors(error)).toEqual(rawProperties)
+    expect(error.message).toBe(builtInMessage)
+    expect(error.message.includes('API error happened')).toBe(true)
+    expect(error.code).toBe(500)
+    expect(error.retryAfter).toBe(10)
+    expect(error.requestId).toBe('test-request')
+    expect(error.requestPathname).toBe('/api/test')
+  })
+
+  it.each([
+    'Custom server message',
+    'Произвольная ошибка сервера',
+    'schema "user_schema" does not exist',
+    'INVALID_API_KEY',
+    'Failed to fetch',
+    'CONNECTION TERMINATED DUE TO CONNECTION TIMEOUT',
+    `prefix: ${builtInMessage}`,
+    `${builtInMessage} custom`,
+    ` ${builtInMessage}`,
+    builtInMessage.toLowerCase(),
+    '__proto__',
+    'constructor',
+    'toString',
+    '',
+    null,
+    undefined,
+  ])('preserves unknown/custom/code/nonexact input %j byte-for-byte', (message) => {
+    expect(getApiErrorDisplayMessage(message)).toBe(message)
+  })
+
+  it('formats only the error fragment in a toast and leaves the raw payload for support', () => {
+    const error = new ResponseError(undefined, 503)
+    const supportParams = { error: error.message, code: error.code }
+    expect(`Не удалось изменить: ${getApiErrorDisplayMessage(error.message)}`).toBe(
+      'Не удалось изменить: Ошибка API при обращении к серверу.'
+    )
+    expect(supportParams).toEqual({ error: builtInMessage, code: 503 })
+    expect(getApiErrorDisplayMessage(getApiErrorDisplayMessage(error.message))).toBe(
+      'Ошибка API при обращении к серверу.'
+    )
+  })
+
+  it('formats canonical ResponseError interpolation without invoking or changing the error', () => {
+    const error = new ResponseError(undefined, 500)
+    const before = Object.getOwnPropertyDescriptors(error)
+    const rawBefore = `${error}`
+    expect(rawBefore).toContain(builtInMessage)
+    expect(`Ошибка запроса: ${getApiErrorDisplayValue(error)}`).toBe(
+      'Ошибка запроса: Ошибка API при обращении к серверу.'
+    )
+    expect(`${error}`).toBe(rawBefore)
+    expect(Object.getOwnPropertyDescriptors(error)).toEqual(before)
+  })
+
+  it('preserves an unknown Error reference and its implicit caption exactly', () => {
+    const error = new Error('custom server failure')
+    expect(getApiErrorDisplayValue(error)).toBe(error)
+    expect(`${getApiErrorDisplayValue(error)}`).toBe(`${error}`)
+  })
+
+  it('preserves an Error with a message accessor without reading the getter', () => {
+    let reads = 0
+    const error = new Error()
+    Object.defineProperty(error, 'message', { get: () => (++reads, builtInMessage) })
+    expect(getApiErrorDisplayValue(error)).toBe(error)
+    expect(reads).toBe(0)
+  })
+
+  it('preserves an Error with a custom toString without invoking it', () => {
+    let calls = 0
+    const error = new Error(builtInMessage)
+    error.toString = () => (++calls, 'custom caption')
+    expect(getApiErrorDisplayValue(error)).toBe(error)
+    expect(calls).toBe(0)
+  })
+
+  it('preserves an Error with a toString accessor without reading it', () => {
+    let reads = 0
+    const error = new Error(builtInMessage)
+    Object.defineProperty(error, 'toString', { get: () => (++reads, () => 'custom caption') })
+    expect(getApiErrorDisplayValue(error)).toBe(error)
+    expect(reads).toBe(0)
+  })
+
+  it('preserves a custom object and JSX element reference without reading its message', () => {
+    let reads = 0
+    const value = { get message() { reads += 1; return builtInMessage } }
+    const element = { type: 'p', props: { children: builtInMessage } }
+    expect(getApiErrorDisplayMessage(value)).toBe(value)
+    expect(getApiErrorDisplayValue(value)).toBe(value)
+    expect(getApiErrorDisplayMessage(element)).toBe(element)
+    expect(reads).toBe(0)
+  })
+})
