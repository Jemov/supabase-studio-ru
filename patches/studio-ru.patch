+const typeLabels: Record<string, string> = {
+  string: 'строка', number: 'число', nan: 'не число', integer: 'целое число',
+  float: 'дробное число', boolean: 'логическое значение', date: 'дата',
+  bigint: 'большое целое число', symbol: 'символ', function: 'функция',
+  undefined: 'отсутствующее значение', null: 'пустое значение', array: 'массив',
+  object: 'объект', unknown: 'неизвестное значение', promise: 'асинхронное значение',
+  void: 'отсутствующее значение', never: 'недопустимое значение', map: 'словарь', set: 'множество',
+}
+const typeLabel = (value: string) => Object.hasOwn(typeLabels, value) ? typeLabels[value] : value
+const show = (value: unknown): string => typeof value === 'bigint' ? String(value) : JSON.stringify(value) ?? String(value)
+
+export const russianValidationErrorMap: ZodErrorMap = (issue, context) => {
+  let message: string
+  switch (issue.code) {
+    case 'invalid_type':
+      message = issue.received === 'undefined' ? 'Обязательное поле' : `Ожидается ${typeLabel(issue.expected)}, получено: ${typeLabel(issue.received)}`
+      break
+    case 'invalid_literal': message = `Ожидается значение ${show(issue.expected)}`; break
+    case 'unrecognized_keys': message = `Неизвестные поля: ${issue.keys.map(show).join(', ')}`; break
+    case 'invalid_union': message = 'Значение не соответствует ни одному допустимому варианту'; break
+    case 'invalid_union_discriminator': message = `Ожидается один из вариантов: ${issue.options.map(show).join(', ')}`; break
+    case 'invalid_enum_value': message = `Допустимые значения: ${issue.options.map(show).join(', ')}. Получено: ${show(issue.received)}`; break
+    case 'invalid_arguments': message = 'Недопустимые аргументы функции'; break
+    case 'invalid_return_type': message = 'Функция вернула значение недопустимого типа'; break
+    case 'invalid_date': message = 'Некорректная дата'; break
+    case 'invalid_string': {
+      if (typeof issue.validation === 'object') {
+        if ('includes' in issue.validation) message = `Значение должно содержать ${show(issue.validation.includes)}${typeof issue.validation.position === 'number' ? ` начиная с позиции ${issue.validation.position}` : ''}`
+        else if ('startsWith' in issue.validation) message = `Значение должно начинаться с ${show(issue.validation.startsWith)}`
+        else message = `Значение должно заканчиваться на ${show(issue.validation.endsWith)}`
+      } else {
+        const formats: Record<string, string> = { email: 'адрес электронной почты', url: 'URL', uuid: 'UUID', cuid: 'CUID', cuid2: 'CUID2', ulid: 'ULID', regex: 'формат значения', datetime: 'дата и время', date: 'дата', time: 'время', duration: 'длительность', ip: 'IP-адрес', cidr: 'CIDR', base64: 'Base64', base64url: 'Base64URL', jwt: 'JWT', emoji: 'эмодзи' }
+        message = `Некорректное значение: ${Object.hasOwn(formats, issue.validation) ? formats[issue.validation] : 'формат значения'}`
+      }
+      break
+    }
+    case 'too_small':
+    case 'too_big': {
+      const small = issue.code === 'too_small'
+      const limit = small ? issue.minimum : issue.maximum
+      const relation = issue.exact ? 'ровно' : small ? issue.inclusive ? 'не меньше' : 'больше' : issue.inclusive ? 'не больше' : 'меньше'
+      if (issue.type === 'string') message = `Количество символов: ${relation} ${limit}`
+      else if (issue.type === 'array' || issue.type === 'set') message = `Количество элементов: ${relation} ${limit}`
+      else if (issue.type === 'date') message = `Дата должна быть ${relation} ${new Date(Number(limit)).toLocaleString('ru-RU')}`
+      else message = `Значение должно быть ${relation} ${limit}`
+      break
+    }
+    case 'invalid_intersection_types': message = 'Не удалось объединить результаты проверки'; break
+    case 'not_multiple_of': message = `Число должно быть кратно ${issue.multipleOf}`; break
+    case 'not_finite': message = 'Число должно быть конечным'; break
+    case 'custom': message = 'Недопустимое значение'; break
+    default: message = context.defaultError
+  }
+  return { message }
+}
+
+// Localize frontend defaults only. Explicit schema messages retain Zod's priority;
+// server validation and API diagnostics keep their original configuration.
+if (typeof window !== 'undefined') z.setErrorMap(russianValidationErrorMap)
