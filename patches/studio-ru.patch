@@ -0,0 +1,243 @@
+import { DOCS_URL } from '@/lib/constants'
+
+type LintText = string | null | undefined
+type StockLintDisplay = {
+  title: readonly [string, string]
+  description: readonly [string, string]
+  detail: readonly [string, string]
+}
+
+// Exact stock messages from the pinned self-hosted advisor SQL. Raw lint data stays intact.
+const STOCK_LINT_DISPLAYS = new Map<string, StockLintDisplay>([
+  ["unindexed_foreign_keys", {
+    title: ["Unindexed foreign keys", "Неиндексированные внешние ключи"],
+    description: ["Identifies foreign key constraints without a covering index, which can impact database performance.", "Выявляет ограничения внешних ключей без покрывающего индекса, что может снижать производительность базы данных."],
+    detail: ["Table `%s.%s` has a foreign key `%s` without a covering index. This can lead to suboptimal query performance.", "В таблице `%s.%s` внешний ключ `%s` не имеет покрывающего индекса. Это может снижать производительность запросов."],
+  }],
+  ["auth_users_exposed", {
+    title: ["Exposed Auth Users", "Открытые пользователи аутентификации"],
+    description: ["Detects if auth.users is exposed to anon or authenticated roles via a view or materialized view in schemas exposed to PostgREST, potentially compromising user data security.", "Проверяет, открыт ли доступ к auth.users для ролей anon или authenticated через обычное или материализованное представление в схемах, доступных через PostgREST. Это может поставить под угрозу безопасность данных пользователей."],
+    detail: ["View/Materialized View \"%s\" in the public schema may expose `auth.users` data to anon or authenticated roles.", "Обычное или материализованное представление \"%s\" в схеме public может открывать данные `auth.users` для ролей anon или authenticated."],
+  }],
+  ["auth_rls_initplan", {
+    title: ["Auth RLS Initialization Plan", "План инициализации RLS для аутентификации"],
+    description: ["Detects if calls to `current_setting()` and `auth.<function>()` in RLS policies are being unnecessarily re-evaluated for each row", "Проверяет, не вычисляются ли вызовы `current_setting()` и `auth.<function>()` в политиках RLS повторно для каждой строки без необходимости."],
+    detail: ["Table `%s.%s` has a row level security policy `%s` that re-evaluates current_setting() or auth.<function>() for each row. This produces suboptimal query performance at scale. Resolve the issue by replacing `auth.<function>()` with `(select auth.<function>())`. See [docs](" + DOCS_URL + "/guides/database/postgres/row-level-security#call-functions-with-select) for more info.", "В таблице `%s.%s` политика безопасности на уровне строк `%s` повторно вычисляет current_setting() или auth.<function>() для каждой строки. На больших объёмах данных это снижает производительность запросов. Чтобы устранить проблему, замените `auth.<function>()` на `(select auth.<function>())`. Подробнее см. в [документации](" + DOCS_URL + "/guides/database/postgres/row-level-security#call-functions-with-select)."],
+  }],
+  ["no_primary_key", {
+    title: ["No Primary Key", "Нет первичного ключа"],
+    description: ["Detects if a table does not have a primary key. Tables without a primary key can be inefficient to interact with at scale.", "Выявляет таблицы без первичного ключа. При больших объёмах данных работа с такими таблицами может быть неэффективной."],
+    detail: ["Table `%s.%s` does not have a primary key", "У таблицы `%s.%s` нет первичного ключа"],
+  }],
+  ["unused_index", {
+    title: ["Unused Index", "Неиспользуемый индекс"],
+    description: ["Detects if an index has never been used and may be a candidate for removal.", "Выявляет индексы, которые ни разу не использовались и могут быть удалены."],
+    detail: ["Index `%s` on table `%s.%s` has not been used", "Индекс `%s` таблицы `%s.%s` не использовался"],
+  }],
+  ["multiple_permissive_policies", {
+    title: ["Multiple Permissive Policies", "Несколько разрешающих политик"],
+    description: ["Detects if multiple permissive row level security policies are present on a table for the same `role` and `action` (e.g. insert). Multiple permissive policies are suboptimal for performance as each policy must be executed for every relevant query.", "Проверяет, есть ли у таблицы несколько разрешающих политик безопасности на уровне строк для одной и той же роли (`role`) и действия (`action`), например insert. Это снижает производительность: каждую политику необходимо выполнять для каждого соответствующего запроса."],
+    detail: ["Table `%s.%s` has multiple permissive policies for role `%s` for action `%s`. Policies include `%s`", "В таблице `%s.%s` для роли `%s` и действия `%s` есть несколько разрешающих политик. Политики: `%s`"],
+  }],
+  ["policy_exists_rls_disabled", {
+    title: ["Policy Exists RLS Disabled", "Есть политики при отключённом RLS"],
+    description: ["Detects cases where row level security (RLS) policies have been created, but RLS has not been enabled for the underlying table.", "Выявляет случаи, когда политики безопасности на уровне строк (RLS) созданы, но RLS для соответствующей таблицы не включён."],
+    detail: ["Table `%s.%s` has RLS policies but RLS is not enabled on the table. Policies include %s.", "В таблице `%s.%s` есть политики RLS, но RLS для таблицы не включён. Политики: %s."],
+  }],
+  ["rls_enabled_no_policy", {
+    title: ["RLS Enabled No Policy", "RLS включён без политик"],
+    description: ["Detects cases where row level security (RLS) has been enabled on a table but no RLS policies have been created.", "Выявляет случаи, когда безопасность на уровне строк (RLS) для таблицы включена, но политики RLS не созданы."],
+    detail: ["Table `%s.%s` has RLS enabled, but no policies exist", "В таблице `%s.%s` включён RLS, но политик нет"],
+  }],
+  ["duplicate_index", {
+    title: ["Duplicate Index", "Дублирующийся индекс"],
+    description: ["Detects cases where two ore more identical indexes exist.", "Выявляет случаи, когда существует два или более одинаковых индекса."],
+    detail: ["Table `%s.%s` has identical indexes %s. Drop all except one of them", "В таблице `%s.%s` есть одинаковые индексы %s. Удалите все, кроме одного"],
+  }],
+  ["security_definer_view", {
+    title: ["Security Definer View", "Представление SECURITY DEFINER"],
+    description: ["Detects views defined with the SECURITY DEFINER property. These views enforce Postgres permissions and row level security policies (RLS) of the view creator, rather than that of the querying user", "Выявляет представления со свойством SECURITY DEFINER. Они применяют разрешения PostgreSQL и политики безопасности на уровне строк (RLS) создателя представления вместо разрешений пользователя, выполняющего запрос."],
