+    title: ["Signed-In Users Can Execute SECURITY DEFINER Function", "Выполнение функции SECURITY DEFINER вошедшими пользователями"],
+    description: ["Detects `SECURITY DEFINER` functions that are callable by signed-in users. Revoke `EXECUTE`, switch the function to `SECURITY INVOKER`, or move it out of your exposed API schema if signed-in users should not call it.", "Обнаруживает функции `SECURITY DEFINER`, которые могут вызывать вошедшие пользователи. Отзовите `EXECUTE`, переключите функцию на `SECURITY INVOKER` или исключите её из схемы, доступной через API, если вошедшие пользователи не должны её вызывать."],
+    detail: ["Function `%s.%s(%s)` can be executed by the `authenticated` role as a `SECURITY DEFINER` function via `/rest/v1/rpc/%s`. Revoke `EXECUTE` or switch it to `SECURITY INVOKER` if that is not intentional.", "Роль `authenticated` может выполнять функцию `%s.%s(%s)` как функцию `SECURITY DEFINER` через `/rest/v1/rpc/%s`. Отзовите `EXECUTE` или переключите функцию на `SECURITY INVOKER`, если такое поведение не предусмотрено."],
+  }],
+])
+const RLS_EXPLANATIONS = new Map<string, string>([
+  [' (both USING and WITH CHECK are always true)', ' (USING и WITH CHECK всегда возвращают истину)'],
+  [' (USING clause is always true)', ' (условие USING всегда возвращает истину)'],
+  [' (WITH CHECK clause is always true)', ' (условие WITH CHECK всегда возвращает истину)'],
+  ['', ''],
+])
+const GRAPHQL_OBJECT_TYPES = new Map<string, string>([
+  ['table', 'Таблица'],
+  ['view', 'Представление'],
+  ['materialized view', 'Материализованное представление'],
+  ['foreign table', 'Внешняя таблица'],
+])
+
+function escapeRegExp(value: string): string {
+  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+}
+
+function getStockCapturePattern(name: string, index: number): string {
+  if (name === 'rls_policy_always_true' && index === 4) {
+    return Array.from(RLS_EXPLANATIONS.keys(), escapeRegExp).join('|')
+  }
+  if (name === 'public_bucket_allows_listing') {
+    if (index === 1) return '\\d+'
+    if (index === 2) return 'policy|policies'
+  }
+  if (
+    (name === 'pg_graphql_anon_table_exposed' ||
+      name === 'pg_graphql_authenticated_table_exposed') && index === 0
+  ) {
+    return Array.from(GRAPHQL_OBJECT_TYPES.keys(), escapeRegExp).join('|')
+  }
+  return '[\\s\\S]*?'
+}
+
+export function getLintTitleDisplay(name: string, text: string): string
+export function getLintTitleDisplay(name: string, text: LintText): LintText
+export function getLintTitleDisplay(name: string, text: LintText): LintText {
+  const entry = STOCK_LINT_DISPLAYS.get(name)
+  return entry !== undefined && entry.title[0] === text ? entry.title[1] : text
+}
+
+export function getLintDescriptionDisplay(name: string, text: string): string
+export function getLintDescriptionDisplay(name: string, text: LintText): LintText
+export function getLintDescriptionDisplay(name: string, text: LintText): LintText {
+  const entry = STOCK_LINT_DISPLAYS.get(name)
+  return entry !== undefined && entry.description[0] === text ? entry.description[1] : text
+}
+
+export function getLintDetailDisplay(name: string, text: string): string
+export function getLintDetailDisplay(name: string, text: LintText): LintText
+export function getLintDetailDisplay(name: string, text: LintText): LintText {
+  const entry = STOCK_LINT_DISPLAYS.get(name)
+  if (entry === undefined || typeof text !== 'string') return text
+
+  const [original, russian] = entry.detail
+  const literals = original.split('%s')
+  const pattern = literals.map((literal, index) =>
+    escapeRegExp(literal) + (index < literals.length - 1
+      ? `(${getStockCapturePattern(name, index)})`
+      : '')
+  ).join('')
+  const match = new RegExp(`^${pattern}$`, 'u').exec(text)
+  if (match === null || match[0] !== text) return text
+
+  // Captured identifiers, roles, SQL and function arguments are copied byte-for-byte.
+  // Only the explicitly known stock explanatory fragments below have display translations.
+  const values = match.slice(1)
+  if (name === 'rls_policy_always_true') {
+    const display = RLS_EXPLANATIONS.get(values[4])
+    if (display === undefined) return text
+    values[4] = display
+  } else if (name === 'public_bucket_allows_listing') {
+    const expectedNoun = values[1] === '1' ? 'policy' : 'policies'
+    if (values[2] !== expectedNoun) return text
+    const lastTwo = Number(values[1].slice(-2))
+    const lastOne = Number(values[1].slice(-1))
+    values[2] = lastTwo >= 11 && lastTwo <= 14 ? 'политик'
+      : lastOne === 1 ? 'политика' : lastOne >= 2 && lastOne <= 4 ? 'политики' : 'политик'
+  } else if (
+    name === 'pg_graphql_anon_table_exposed' ||
+    name === 'pg_graphql_authenticated_table_exposed'
+  ) {
+    const display = GRAPHQL_OBJECT_TYPES.get(values[0])
+    if (display === undefined) return text
+    values[0] = display
+  }
+
+  return russian.split('%s').map((literal, index) =>
+    (index === 0 ? '' : values[index - 1]) + literal
+  ).join('')
+}
