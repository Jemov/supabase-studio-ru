@@ -0,0 +1,12 @@
+/** Translate only reviewed stock extension product labels; preserve API metadata and custom text. */
+const STOCK_EXTENSION_PRODUCTS = new Map<string, readonly [string, string]>([
+  ["index_advisor",["Index Advisor Report","Отчёт о рекомендуемых индексах"]],
+  ["pg_net",["Database Webhooks","Вебхуки базы данных"]],
+  ["pg_stat_statements",["Query Performance","Производительность запросов"]],
+  ["wrappers",["Supabase Wrappers","Обёртки Supabase"]],
+])
+
+export function getExtensionProductDisplay(name: string, product: string): string {
+  const known = STOCK_EXTENSION_PRODUCTS.get(name)
+  return known !== undefined && known[0] === product ? known[1] : product
+}
