diff --git a/apps/studio/components/interfaces/Integrations/Landing/integrationDisplay.ts b/apps/studio/components/interfaces/Integrations/Landing/integrationDisplay.ts
new file mode 100644
index 0000000..cf96179
--- /dev/null
+++ b/apps/studio/components/interfaces/Integrations/Landing/integrationDisplay.ts
@@ -0,0 +1,32 @@
+import type { IntegrationDefinition } from './Integrations.constants'
+
+const INTEGRATION_DISPLAY_NAMES: Record<string, string> = {
+  queues: 'Очереди',
+  cron: 'Планировщик заданий',
+  vault: 'Хранилище секретов',
+  webhooks: 'Вебхуки БД',
+  data_api: 'API данных',
+  stripe_sync_engine: 'Модуль синхронизации Stripe',
+}
+
+export function getIntegrationDisplayName(
+  integration: Pick<IntegrationDefinition, 'id' | 'name'> | null | undefined
+): string {
+  if (!integration) return 'Интеграция не найдена'
+  const displayName = Object.hasOwn(INTEGRATION_DISPLAY_NAMES, integration.id)
+    ? INTEGRATION_DISPLAY_NAMES[integration.id]
+    : undefined
+  if (displayName) return displayName
+  if (integration.id.endsWith('_wrapper') && integration.name.endsWith(' Wrapper')) {
+    return `Обёртка ${integration.name.slice(0, -' Wrapper'.length)}`
+  }
+  return integration.name
+}
+
+export function getIntegrationStatusLabel(
+  status: IntegrationDefinition['status']
+): string | undefined {
+  if (status === 'alpha') return 'Альфа'
+  if (status === 'beta') return 'Бета'
+  return status
+}
